{
  "info": {
    "name": "Contacts API",
    "description": "Manual acceptance requests for the Contacts API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "contactId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Create contact",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"João Silva\",\n  \"telefone\": \"(11) 98765-4321\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/contatos",
          "host": ["{{baseUrl}}"],
          "path": ["contatos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status code is 201\", () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.collectionVariables.set('contactId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
